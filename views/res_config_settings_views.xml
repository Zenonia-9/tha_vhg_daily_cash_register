<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_cash_register" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.vhg.dcr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Daily Cash Register" name="vhg_daily_cash_register_settings">
                    <setting string="Cash Journals" help="Journals loaded onto each new Daily Cash Register. Use a separate journal per currency.">
                        <field name="cash_register_journal_ids" widget="many2many_tags"/>
                    </setting>
                    <setting string="Dept Analytic Plan" help="Leave empty to take any analytic account on the cash line as Dept.">
                        <field name="cash_register_analytic_plan_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
